# Copy this file to scripts\nuvio.local.env and fill in the values.
# nuvio.local.env is git-ignored and never leaves your machine.
# scripts\build.bat loads it before running Gradle.
#
# Format: KEY=VALUE, one per line, no quotes, no spaces around '='.

NUVIO_SUPABASE_URL=https://your-project.supabase.co
NUVIO_SUPABASE_ANON_KEY=your-anon-key
NUVIO_SUPABASE_FALLBACK_URL=
